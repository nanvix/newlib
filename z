#!/bin/bash

#
# Utility for building development tools for Nanvix.
#
# Run './z help' for more information on how to use this utility.
#
# Relevant Environment Variables
#
#   - Z_TARGET: Target architecture.
#   - Z_STAGE: Build stage.
#   - Z_INSTALL_LOCATION: Installation directory.
#   - Z_SYSROOT_LOCATION: Sysroot directory.
#   - Z_RELEASE_NAME: Release name.
#
# shellcheck disable=SC2329
# shellcheck disable=SC2317
# shellcheck disable=SC2034

#==================================================================================================

# Fast fail on errors, unset variables, and pipe failures.
set -euo pipefail

#==================================================================================================
# Import Utils Script
#==================================================================================================

UTILS_SCRIPT_VERSION="c24dedaf76a4833b388597805e2c0625cef0c453"
UTILS_SCRIPT_URL="https://raw.githubusercontent.com/nanvix/scripts/${UTILS_SCRIPT_VERSION}/utils.sh"

utils_script="/tmp/utils-${UTILS_SCRIPT_VERSION}.sh"

# Download only if the file doesn't exist or is empty
if [[ ! -s "$utils_script" ]]; then

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$UTILS_SCRIPT_URL" -o "$utils_script" || {
            echo "Failed to download utils.sh"
            rm -f "$utils_script"
            exit 1
        }
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$utils_script" "$UTILS_SCRIPT_URL" || {
            echo "Failed to download utils.sh"
            rm -f "$utils_script"
            exit 1
        }
    else
        echo "curl or wget required"
        exit 1
    fi
fi

# Source the downloaded script
# shellcheck disable=SC1090
source "${utils_script}"

#==================================================================================================
# Z Constants
#==================================================================================================

# Project name.
readonly Z_PROJECT_NAME="NewLib"
# Directory used when building, empty if not required.
readonly Z_PROJECT_BUILD_DIR=""

# Required Build Tools (tool_name => minimum_version)
readonly -A Z_PROJECT_REQUIRED_TOOLS=(
    ["gcc"]="13.3.0"
    ["make"]="4.3.0"
    ["wget"]="1.21.4"
    ["bzip2"]="1.0.8"
    ["tar"]="1.34.0"
)

# Required System Packages for Setup
readonly Z_PROJECT_REQUIRED_PACKAGES=("build-essential" "wget" "bzip2" "tar")

#==================================================================================================
# Project-Specific Constants
#==================================================================================================

# Build Targets
readonly BUILD_TARGETS=("all")

# Install Targets
readonly INSTALL_TARGETS=("install")

# GCC.
readonly GCC_VERSION="12.4.0"
readonly GCC_SHORT_COMMIT_HASH="cd2f75b2e55"
readonly GCC_URL="https://github.com/nanvix/gcc/releases/download/nanvix-v${GCC_VERSION}-${GCC_SHORT_COMMIT_HASH}/nanvix-gcc-${GCC_VERSION}-${GCC_SHORT_COMMIT_HASH}-stage0.tar.bz2"
readonly GCC_SHA256_CHECKSUM="sha256:f4270b07e81497f0dd8851d83248d5958a87d2f4af8537f2bb5f0a1be7b25a64"

#==================================================================================================
# Project-Specific Functions
#==================================================================================================

#
# Description
#
#   Executes project-specific steps for downloading dependencies.
#
# Return Value
#
#   - On success, this function returns zero.
#   - On failure, this function returns non-zero.
#
download_steps() {
    # Download and extract GCC if sysroot location is not set.
    # Skip GCC download only when Binutils for the target is already installed
    # (indicating we're in a Clang cross-compilation environment with Binutils).
    if [[ -z "${Z_SYSROOT_LOCATION}" ]] && ! command -v "${Z_TARGET}-as" >/dev/null 2>&1; then
        local sysroot_location="${Z_INSTALL_LOCATION}"

        local gcc_tar_bz2_file
        gcc_tar_bz2_file=$(download "$GCC_URL" "$GCC_SHA256_CHECKSUM") || {
            print_error "Failed to download GCC."
            return 1
        }
        extract_tar_bz2 "$gcc_tar_bz2_file" "${sysroot_location}" || {
            print_error "Failed to extract GCC."
            return 1
        }
    elif command -v "${Z_TARGET}-as" >/dev/null 2>&1; then
        print_info "Target Binutils detected; skipping GCC download."
    fi

    return 0
}

#
# Description
#
#   Executes project-specific steps for configuring a build.
#
# Return Value
#
#   - On success, this function returns zero.
#   - On failure, this function returns non-zero.
#
# Usage Example
#
#   configure_steps "i686-nanvix" "/usr/local"
#
configure_steps() {
    # Enable compilation caching if possible.
    enable_compilation_caching || {
        print_warning "Compilation caching disabled."
    }

    # Detect cross-compiler: prefer ${Z_TARGET}-gcc, fall back to clang
    # (only when target Binutils are available).
    local cc_for_target_flags=()
    if command -v "${Z_TARGET}-gcc" >/dev/null 2>&1; then
        print_info "Using GCC cross-compiler: ${Z_TARGET}-gcc"
    elif command -v clang >/dev/null 2>&1 && command -v "${Z_TARGET}-as" >/dev/null 2>&1; then
        print_info "Using Clang cross-compiler: clang --target=i686-unknown-nanvix"
        # Clang is stricter than GCC: implicit function declarations are errors
        # in C99+. Newlib code relies on implicit declarations in some places,
        # so we downgrade to warnings for compatibility.
        local clang_compat_flags="-Wno-error=implicit-function-declaration"
        cc_for_target_flags=(
            "CC_FOR_TARGET=clang --target=i686-unknown-nanvix ${clang_compat_flags}"
            "CXX_FOR_TARGET=clang++ --target=i686-unknown-nanvix"
            "AS_FOR_TARGET=${Z_TARGET}-as"
            "LD_FOR_TARGET=${Z_TARGET}-ld"
            "AR_FOR_TARGET=${Z_TARGET}-ar"
            "RANLIB_FOR_TARGET=${Z_TARGET}-ranlib"
        )
    else
        print_error "No cross-compiler found. Install ${Z_TARGET}-gcc or clang + ${Z_TARGET} Binutils."
        return 1
    fi

    ./configure \
        --target="${Z_TARGET}" \
        --prefix="${Z_INSTALL_LOCATION}" \
        --disable-multilib \
        "${cc_for_target_flags[@]}" || {
        print_error "Configuration failed."
        return 1
    }

    return 0
}

#
# Description
#
#   Project-specific steps for building the project.
#
# Parameters
#
#   - $1: Number of parallel build jobs.
#
# Usage Example
#
#   build_steps 4 "all" "check"
#
build_steps() {
    local parallel_build_option=$1

    # Enable compilation caching if possible.
    enable_compilation_caching || {
        print_warning "Compilation caching disabled."
    }

    make -j "${parallel_build_option}" "${BUILD_TARGETS[@]}" || {
        print_error "Build failed for targets: '${BUILD_TARGETS[*]}'."
        return 1
    }

    return 0
}

#
# Description
#
#   Project-specific steps for installing the project.
#
# Return Value
#
#   - On success, this function returns zero.
#   - On failure, this function returns non-zero.
#
# Usage Example
#
#   install_steps "install" "/usr/local"
#
install_steps() {
    make "${INSTALL_TARGETS[@]}" || {
        print_error "Installation failed."
        return 1
    }

    # Create includes directory.
    mkdir -p "${Z_INSTALL_LOCATION}/usr/include" || {
        print_error "Failed to create '${Z_INSTALL_LOCATION}/usr/include' directory."
        return 1
    }

    # Copy headers to include directory.
    # NOTE: This is a workaround for GCC fix-includes (https://forum.osdev.org/viewtopic.php?t=26999)
    cp -r "${Z_INSTALL_LOCATION}/${Z_TARGET}/include/" "${Z_INSTALL_LOCATION}/usr/" || {
        print_error "Failed to copy include files."
        return 1
    }

    return 0
}

#==================================================================================================
# Main Script
#==================================================================================================

# Run main function with all arguments
zmain "$@" || {
    exit 1
}

exit 0
